{
  "name": "my-documents",
  "version": "1.0.0",
  "description": "Document repository with Marp presentations",
  "scripts": {
    "build": "npx @marp-team/marp-cli src/architecture-presentation.md -o dist/architecture-presentation.html --allow-local-files && rsync -a --delete src/images/ dist/images/",
    "build:pdf": "npx @marp-team/marp-cli src/architecture-presentation.md -o dist/architecture-presentation.pdf --pdf --allow-local-files",
    "build:pptx": "npx @marp-team/marp-cli src/architecture-presentation.md -o dist/architecture-presentation.pptx --pptx --allow-local-files",
    "build:all": "npm run build && npm run build:pdf && npm run build:pptx",
    "watch": "npx @marp-team/marp-cli -s src/architecture-presentation.md -w",
    "preview": "npx @marp-team/marp-cli -s src/architecture-presentation.md"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^3.4.0"
  }
}
